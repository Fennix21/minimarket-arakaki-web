# Llaves para trabajar desde la PC. Copia este archivo como .env (sin "ejemplo") y llena
# los valores. El .env está en .gitignore: NUNCA se sube al repo ni se manda por chat.
#
#   1. Copiar:  cp .env.ejemplo .env      (en PowerShell: Copy-Item .env.ejemplo .env)
#   2. Llenar las dos primeras líneas con las llaves de Upstash.
#   3. Correr:  node tools/dev-server.js  → localhost:3210 con datos DE VERDAD.
#
# Sin .env el dev-server sigue funcionando igual que siempre, con datos de muestra.

# ---------------------------------------------------------------------------
# La base de datos (lo único imprescindible)
# ---------------------------------------------------------------------------
# De dónde salen: Upstash → la base → REST API (o Vercel → proyecto → Settings →
# Environment Variables). Ojo: esas pantallas copian la línea COMPLETA, con el nombre y
# comillas — se puede pegar tal cual encima de la línea de abajo, se limpia sola.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Freno de seguridad: 1 = solo lectura (puedes mirar TODO, pero nada se graba).
# Déjalo en 1 mientras apuntes a la base de producción, que tiene clientes reales.
# Ponlo en 0 solo si estás apuntando a una base de PRUEBAS.
#   Base de pruebas: crear otra en Upstash y llenarla con
#   node tools/migrar-redis.js copiar --solo-config   (copia la configuración, sin datos de clientes)
ARAKAKI_REDIS_RO=1

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------
# Contraseña para entrar al panel en local (localhost:3210/panel).
ARAKAKI_ADMIN_PASS=

# Para probar el chat web y el bot con IA de verdad (cada prueba consume saldo).
ANTHROPIC_API_KEY=

# Correos del Club (recuperación de clave, promos). Sin esto, se degrada solo.
RESEND_API_KEY=
RESEND_FROM=

# Base de DESTINO, solo para la mudanza al dueño (tools/migrar-redis.js copiar/verificar).
# Este mismo .env lo lee esa herramienta, así no hay que escribir las llaves en cada terminal.
UPSTASH_DESTINO_REST_URL=
UPSTASH_DESTINO_REST_TOKEN=

# ---------------------------------------------------------------------------
# ⚠️ NO pongas aquí las llaves de WhatsApp (WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID).
# Con ellas puestas, cada pedido de prueba le mandaría un WhatsApp REAL al dueño.
# El freno de solo lectura no lo evita: ese aviso no pasa por la base.
# ---------------------------------------------------------------------------
